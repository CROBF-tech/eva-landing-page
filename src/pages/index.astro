---
import Layout from '../layouts/Layout.astro';
import EmailForm from '../components/EmailForm.astro';
import Brand from '../components/Brand.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
---

<Layout>
	<main class="min-h-screen bg-background text-foreground">
		{/* ───────────── HEADER ───────────── */}
		<header class="px-4 pt-8 sm:px-6 sm:pt-10 lg:px-8">
			<nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 sm:gap-5">
				<Brand size="small" />
				<div class="flex items-center gap-3 sm:gap-5">
					<a
						href="#sumate"
						class="text-sm font-medium text-foreground/80 transition hover:text-primary focus:text-primary focus:outline-none"
					>
						Sumate →
					</a>
					<ThemeToggle />
				</div>
			</nav>
		</header>

		{/* ───────────── HERO ───────────── */}
		<section class="px-4 pt-12 pb-20 sm:px-6 sm:pt-20 sm:pb-32 lg:px-8">
			<div
				class="mx-auto grid max-w-6xl items-end gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-16"
			>
				{/* Columna izquierda: tesis */}
				<div class="relative">
					<p
						class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground"
					>
						Eva · para mujeres
					</p>

					<h1
						class="font-display mt-6 text-[clamp(2.25rem,9vw,5.5rem)] font-medium leading-[1.02] tracking-[-0.025em] text-foreground"
					>
						Tu compañía
						<span class="block italic text-primary">antes de salir.</span>
					</h1>

					<p
						class="mt-8 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg lg:text-xl"
					>
						Contale tu plan a Eva — dónde vas, con quién y cuánto tiempo te lleva.
						Si todo sale bien, confirmás que llegaste.
						<span class="text-foreground">Si no podés hacerlo, Eva avisa.</span>
					</p>

					<div id="sumate" class="mt-10 max-w-md">
						<EmailForm id="email-form-hero" />
						<p class="mt-3 text-xs text-muted-foreground/80">
							Te escribimos una vez, cuando Eva esté lista. Tu correo no se comparte.
						</p>
					</div>
				</div>

				{/* Columna derecha: firma tipográfica (decorativa: ya está en el header) */}
				<div class="hidden lg:flex lg:justify-end lg:items-end" aria-hidden="true">
					<Brand size="hero" />
				</div>
			</div>
		</section>

		{/* ───────────── TRES SALIDAS ───────────── */}
		<section class="border-t border-border/70 bg-secondary/40 px-4 py-20 sm:px-6 sm:py-32 lg:px-8">
			<div class="mx-auto max-w-6xl">
				<p
					class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground"
				>
					Momentos
				</p>
				<h2
					class="font-display mt-4 max-w-2xl text-3xl font-medium tracking-[-0.02em] text-foreground sm:text-5xl sm:leading-[1.05]"
				>
					Tres salidas que ya cambiaron con Eva.
				</h2>

				<div class="mt-12 space-y-12 sm:mt-16 sm:space-y-20">
					{[
						{
							eyebrow: 'Volvés sola',
							title: 'Tomar un taxi de noche.',
							body: 'Antes de subir, contás cuánto tarda el viaje. Si Eva no recibe tu confirmación al llegar, le avisa a quien vos elegiste — con la ruta y la última ubicación.',
						},
						{
							eyebrow: 'Quedás con alguien',
							title: 'Conocer a una persona por primera vez.',
							body: 'Dejás un plan con el lugar, la hora estimada y un mensaje. Tus contactos lo ven solo si algo no sale como esperabas.',
						},
						{
							eyebrow: 'Te movés lejos',
							title: 'Viajar con desconocidos.',
							body: 'Un recorrido largo, un país nuevo. Eva reconstruye tu trayecto mientras se mueve el plan y lo entrega junto si la alerta se activa.',
						},
					].map((item) => (
						<article class="grid gap-6 sm:grid-cols-[12rem_1fr] sm:gap-12">
							<p class="font-sans text-xs font-medium uppercase tracking-[0.18em] text-primary">
								{item.eyebrow}
							</p>
							<div>
								<h3 class="font-display text-2xl font-medium tracking-[-0.015em] text-foreground sm:text-3xl">
									{item.title}
								</h3>
								<p class="mt-3 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
									{item.body}
								</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		{/* ───────────── CÓMO FUNCIONA ───────────── */}
		<section class="px-4 py-20 sm:px-6 sm:py-32 lg:px-8">
			<div class="mx-auto max-w-6xl">
				<p
					class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground"
				>
					Cómo funciona
				</p>
				<h2
					class="font-display mt-4 max-w-2xl text-3xl font-medium tracking-[-0.02em] text-foreground sm:text-5xl sm:leading-[1.05]"
				>
					Cuatro pasos. Antes de salir.
				</h2>

				<ol class="mt-12 space-y-10 sm:mt-16 sm:space-y-16">
					{[
						{
							n: '01',
							title: 'Contás tu plan.',
							body: 'Lugar, actividad, tiempo estimado, margen de error, un mensaje para tus contactos. Eva lo guarda.',
						},
						{
							n: '02',
							title: 'Eva empieza a registrar.',
							body: 'Mientras el plan está activo, tu ubicación se guarda de forma discreta para reconstruir el recorrido si hace falta.',
						},
						{
							n: '03',
							title: 'Llega la hora, Eva te pregunta.',
							body: 'Un toque para confirmar que estás bien. Otro para extender el seguimiento. No necesitás abrir la app.',
						},
						{
							n: '04',
							title: 'Si no respondés, Eva actúa.',
							body: 'Pasado el margen que definiste, Eva notifica automáticamente a tus contactos seguros con la información del plan.',
						},
					].map((step) => (
						<li class="grid items-baseline gap-6 sm:grid-cols-[8rem_1fr] sm:gap-12">
							<span
								class="font-display text-7xl font-light italic text-primary/70 sm:text-8xl"
								aria-hidden="true"
							>
								{step.n}
							</span>
							<div>
								<h3 class="font-display text-2xl font-medium tracking-[-0.015em] text-foreground sm:text-3xl">
									{step.title}
								</h3>
								<p class="mt-3 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
									{step.body}
								</p>
							</div>
						</li>
					))}
				</ol>
			</div>
		</section>

		{/* ───────────── SI NO RESPONDÉS ───────────── */}
		<section class="theme-inverted px-4 py-20 sm:px-6 sm:py-32 lg:px-8">
			<div class="mx-auto max-w-5xl">
				<p
					class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-primary"
				>
					El protocolo
				</p>
				<p
					class="font-display mt-8 text-3xl font-medium leading-[1.1] tracking-[-0.02em] sm:text-5xl sm:leading-[1.05]"
				>
					Si la confirmación no llega dentro del margen que vos misma definiste,
					Eva envía automáticamente un mensaje a cada contacto seguro con todo lo
					que necesita para actuar:
				</p>

				<ul class="mt-12 grid gap-6 sm:grid-cols-2 sm:gap-x-12 sm:gap-y-4">
					{[
						'Tu nombre y descripción del plan',
						'El lugar previsto y la hora de inicio',
						'La última ubicación registrada',
						'El recorrido realizado hasta ese momento',
						'Tu teléfono, para comunicarse',
						'El mensaje que vos misma escribiste antes de salir',
					].map((item) => (
						<li class="flex items-baseline gap-3 text-base sm:text-lg">
							<span class="font-display text-primary" aria-hidden="true">—</span>
							<span>{item}</span>
						</li>
					))}
				</ul>

				<p
					class="font-display mt-12 max-w-3xl text-lg italic leading-relaxed sm:text-xl"
				>
					El objetivo no es reemplazar a los servicios de emergencia. Es darles a
					las personas que te quieren toda la información para que no pierdan
					tiempo cuando más lo necesitás.
				</p>
			</div>
		</section>

		{/* ───────────── LO QUE EVA NO HACE ───────────── */}
		<section class="px-4 py-20 sm:px-6 sm:py-32 lg:px-8">
			<div class="mx-auto max-w-5xl">
				<p
					class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground"
				>
					Lo que Eva no hace
				</p>
				<h2
					class="font-display mt-4 max-w-2xl text-3xl font-medium tracking-[-0.02em] text-foreground sm:text-5xl sm:leading-[1.05]"
				>
					Lo que no vas a encontrar acá.
				</h2>

				<dl class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2">
					{[
						{
							dt: 'No comparte tu ubicación en tiempo real.',
							dd: 'Mientras un plan está activo, los contactos seguros no ven dónde estás. Reciben información solo si la alerta se activa.',
						},
						{
							dt: 'No vive pendiente de una emergencia.',
							dd: 'Eva no busca detectar lo peor. Busca convertirse en un hábito antes de salir, como mandar "ya llegué".',
						},
						{
							dt: 'No comparte datos con terceros.',
							dd: 'Tu información no se vende ni se usa para publicidad. Solo vive para que el plan funcione.',
						},
						{
							dt: 'No reemplaza a la policía ni al 911.',
							dd: 'Eva es una capa previa de aviso. La decisión de llamar a emergencias siempre queda en quien te quiere.',
						},
					].map((item) => (
						<div>
							<dt class="font-display text-xl font-medium text-foreground sm:text-2xl">
								{item.dt}
							</dt>
							<dd class="mt-2 text-base leading-relaxed text-muted-foreground">
								{item.dd}
							</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		{/* ───────────── MODO SILENCIOSO ───────────── */}
		<section class="border-t border-border/70 bg-secondary/40 px-4 py-20 sm:px-6 sm:py-32 lg:px-8">
			<div class="mx-auto max-w-3xl">
				<p
					class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground"
				>
					Para cuando no podés actuar libremente
				</p>
				<h2
					class="font-display mt-4 text-3xl font-medium tracking-[-0.02em] text-foreground sm:text-5xl sm:leading-[1.05]"
				>
					Hay situaciones en las que avisar tampoco es una opción.
				</h2>
				<p
					class="mt-8 text-lg leading-relaxed text-muted-foreground sm:text-xl"
				>
					Eva fue pensada también para esos momentos. Tiene un mecanismo pensado
					para pedir ayuda sin que se note, sin botones visibles, sin gestos que
					puedan delatarte frente a quien te esté apretando.
				</p>
				<p
					class="mt-6 text-base italic leading-relaxed text-muted-foreground/80 sm:text-lg"
				>
					No lo describimos en detalle acá a propósito — para que solo vos sepas
					cómo usarlo.
				</p>
			</div>
		</section>

		{/* ───────────── DEJANOS TU NOTA ───────────── */}
		<section class="border-t border-border/70 bg-secondary/40 px-4 py-20 sm:px-6 sm:py-32 lg:px-8">
			<div class="mx-auto max-w-3xl">
				<p
					class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground"
				>
					Sumate y contanos
				</p>
				<h2
					class="font-display mt-4 text-3xl font-medium leading-[1.05] tracking-[-0.02em] text-foreground sm:text-5xl"
				>
					Dejanos tu correo
					<span class="block italic text-primary">y, si querés, una nota.</span>
				</h2>
				<p class="mt-6 text-lg leading-relaxed text-muted-foreground sm:text-xl">
					Tu correo es para avisarte cuando Eva esté lista. La nota es
					opcional: un mensaje, una idea, una situación que te gustaría que
					resolvamos. Leemos cada una.
				</p>
				<div class="mt-10">
					<WaitlistForm id="waitlist-form" />
				</div>
			</div>
		</section>

		{/* ───────────── FOOTER ───────────── */}
		<footer class="border-t border-border/70 px-4 py-10 sm:px-6 lg:px-8">
			<div
				class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 text-sm text-muted-foreground sm:flex-row"
			>
				<p>© {new Date().getFullYear()} Eva. Hecho con cuidado.</p>
				<p class="text-muted-foreground/80">
					Contale tu plan. Nosotros nos encargamos del resto.
				</p>
			</div>
		</footer>
	</main>
</Layout>