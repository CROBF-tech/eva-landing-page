---
type Props = {
  id?: string;
};

const { id = 'waitlist-form' } = Astro.props;
const emailId = `${id}-email`;
const noteId = `${id}-note`;
const textId = `${id}-btn-text`;
const loaderId = `${id}-btn-loader`;
---

<form
  id={id}
  method="POST"
  data-waitlist-form
  novalidate
  class="flex w-full max-w-xl flex-col gap-3"
>
  <div class="flex flex-col gap-3 sm:flex-row">
    <label class="sr-only" for={emailId}>Tu correo electrónico</label>
    <input
      id={emailId}
      type="email"
      name="email"
      placeholder="tu@email.com"
      required
      autocomplete="email"
      maxlength="254"
      class="flex-1 rounded-xl border border-input bg-background px-4 py-3 text-base text-foreground placeholder:text-muted-foreground/70 focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/40"
    />
    <button
      type="submit"
      class="inline-flex items-center justify-center whitespace-nowrap rounded-xl bg-primary px-5 py-3 text-sm font-medium text-primary-foreground transition hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring/50 disabled:opacity-70 sm:px-6 sm:text-base"
    >
      <span id={textId} data-slot="btn-text">Sumarme a la lista</span>
      <span id={loaderId} data-slot="btn-loader" class="hidden">Guardando...</span>
    </button>
  </div>

  <label class="sr-only" for={noteId}>Una nota opcional (mensaje u opinión)</label>
  <textarea
    id={noteId}
    name="note"
    rows="3"
    maxlength="500"
    placeholder="Si querés, dejanos un mensaje, una idea o lo que te gustaría ver en Eva."
    class="w-full resize-none rounded-xl border border-input bg-background px-4 py-3 text-base text-foreground placeholder:text-muted-foreground/70 focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/40"
  ></textarea>
</form>

<script>
  import { actions, isInputError } from 'astro:actions';

  type Slots = {
    input: HTMLInputElement;
    note: HTMLTextAreaElement;
    button: HTMLButtonElement;
    text: HTMLElement;
    loader: HTMLElement;
  };

  type EvaModalApi = {
    success: (msg: string) => void;
    error: (msg: string) => void;
  };

  const getModal = (): EvaModalApi | undefined => {
    const registry = (window as unknown as { __evaModal?: Record<string, EvaModalApi> })
      .__evaModal;
    if (!registry) return undefined;
    return registry['eva-modal'];
  };

  const forms = document.querySelectorAll<HTMLFormElement>('form[data-waitlist-form]');

  for (const form of Array.from(forms)) {
    const slots: Partial<Slots> = {
      input: form.querySelector<HTMLInputElement>('input[name="email"]') ?? undefined,
      note: form.querySelector<HTMLTextAreaElement>('textarea[name="note"]') ?? undefined,
      button: form.querySelector<HTMLButtonElement>('button[type="submit"]') ?? undefined,
      text: form.querySelector<HTMLElement>('[data-slot="btn-text"]') ?? undefined,
      loader: form.querySelector<HTMLElement>('[data-slot="btn-loader"]') ?? undefined,
    };

    if (Object.values(slots).some((el) => !el)) continue;
    const { input, note, button, text, loader } = slots as Slots;

    const setLoading = (isLoading: boolean) => {
      text.classList.toggle('hidden', isLoading);
      loader.classList.toggle('hidden', !isLoading);
      button.disabled = isLoading;
      input.disabled = isLoading;
      note.disabled = isLoading;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!input.checkValidity()) {
        input.reportValidity();
        getModal()?.error('Ingresá un correo electrónico válido.');
        return;
      }

      setLoading(true);

      const payload = {
        email: input.value.trim(),
        note: note.value.trim() === '' ? null : note.value.trim(),
      };

      const { error: actionError } = await actions.joinWaitlist(payload);

      if (actionError) {
        if (isInputError(actionError)) {
          const firstField = Object.values(actionError.fields).flat()[0];
          getModal()?.error(firstField ?? 'Revisá los datos e intentá de nuevo.');
        } else {
          getModal()?.error(
            actionError.message ?? 'No pudimos guardar tu correo. Intentá más tarde.'
          );
        }
      } else {
        form.reset();
        getModal()?.success('Gracias. Te avisamos cuando Eva esté lista.');
      }

      setLoading(false);
    });
  }
</script>