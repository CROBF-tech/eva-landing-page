---
type Props = {
  id?: string;
};

const { id = 'email-form' } = Astro.props;
const inputId = `${id}-input`;
const textId = `${id}-btn-text`;
const loaderId = `${id}-btn-loader`;
const messageId = `${id}-message`;
---

<form
  id={id}
  action="/api/register"
  method="POST"
  class="flex w-full max-w-md flex-col gap-3 sm:flex-row"
  novalidate
>
  <label class="sr-only" for={inputId}>Tu correo electrónico</label>
  <input
    id={inputId}
    type="email"
    name="email"
    placeholder="tu@email.com"
    required
    autocomplete="email"
    class="flex-1 rounded-xl border border-input bg-background px-4 py-3 text-base text-foreground placeholder:text-muted-foreground/70 focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/40"
  />
  <button
    type="submit"
    class="inline-flex items-center justify-center whitespace-nowrap rounded-xl bg-primary px-5 py-3 text-sm font-medium text-primary-foreground transition hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring/50 disabled:opacity-70 sm:px-6 sm:text-base"
  >
    <span id={textId}>Avisame cuando Eva esté lista</span>
    <span id={loaderId} class="hidden">Guardando...</span>
  </button>
  <p
    id={messageId}
    class="sr-only"
    role="status"
    aria-live="polite"
  ></p>
</form>

<script is:inline define:vars={{ id, inputId, textId, loaderId, messageId }}>
  (function () {
    const form = document.getElementById(id);
    if (!form) return;
    const input = document.getElementById(inputId);
    const btnText = document.getElementById(textId);
    const btnLoader = document.getElementById(loaderId);
    const message = document.getElementById(messageId);
    const button = form.querySelector('button');

    function setLoading(isLoading) {
      btnText.classList.toggle('hidden', isLoading);
      btnLoader.classList.toggle('hidden', !isLoading);
      button.disabled = isLoading;
      input.disabled = isLoading;
    }

    function showMessage(text, type) {
      message.textContent = text;
      message.classList.remove('sr-only');
      message.className =
        type === 'success'
          ? 'text-sm text-center w-full sm:col-span-2 text-primary font-medium'
          : 'text-sm text-center w-full sm:col-span-2 text-destructive';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const email = formData.get('email');

      setLoading(true);
      showMessage('', 'success');

      try {
        const response = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        const data = await response.json().catch(() => ({}));

        if (response.ok) {
          form.reset();
          showMessage('Gracias. Te avisamos cuando Eva esté lista.', 'success');
        } else {
          showMessage(data.error || 'Hubo un error. Intentá de nuevo.', 'error');
        }
      } catch {
        showMessage('No pudimos conectarnos. Intentá más tarde.', 'error');
      } finally {
        setLoading(false);
      }
    });
  })();
</script>